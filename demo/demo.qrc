    <file alias="icons/window-controls/window-minimize.svg">../icons/window-controls/window-minimize.svg</file>
    <file alias="icons/window-controls/window-maximize.svg">../icons/window-controls/window-maximize.svg</file>
    <file alias="icons/window-controls/window-restore.svg">../icons/window-controls/window-restore.svg</file>
