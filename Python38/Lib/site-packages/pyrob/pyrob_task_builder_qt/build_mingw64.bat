@echo off
setlocal ENABLEDELAYEDEXPANSION

rem Qt 5.12.12 + MinGW 7.3 (64-bit) defaults. Override by setting QTDIR/MINGW beforehand.
if "%QTDIR%"=="" set "QTDIR=C:\Qt\Qt5.12.12\5.12.12\mingw73_64"
if "%MINGW%"=="" set "MINGW=C:\Qt\Qt5.12.12\Tools\mingw730_64"

if not exist "%QTDIR%\bin\qmake.exe" (
  echo [ERROR] qmake not found: "%QTDIR%\bin\qmake.exe"
  echo        Set QTDIR to your Qt MinGW64 path (e.g. C:\Qt\Qt5.12.12\5.12.12\mingw73_64)
  exit /b 1
)

if not exist "%MINGW%\bin\mingw32-make.exe" (
  echo [ERROR] mingw32-make not found: "%MINGW%\bin\mingw32-make.exe"
  echo        Set MINGW to your Qt MinGW toolchain path (e.g. C:\Qt\Qt5.12.12\Tools\mingw730_64)
  exit /b 1
)

set "PATH=%QTDIR%\bin;%MINGW%\bin;%PATH%"

pushd "%~dp0"
echo [INFO] Using QMake: %QTDIR%\bin\qmake.exe
echo [INFO] Using Make : %MINGW%\bin\mingw32-make.exe

echo [STEP] qmake (release)
qmake PyrobTaskBuilder.pro -spec win32-g++ "CONFIG+=release"
if errorlevel 1 goto :error

echo [STEP] mingw32-make
mingw32-make -j%NUMBER_OF_PROCESSORS%
if errorlevel 1 goto :error

echo [STEP] windeployqt
windeployqt.exe bin\PyrobTaskBuilder.exe --release --compiler-runtime
if errorlevel 1 goto :error

echo [OK] Build complete: %cd%\bin\PyrobTaskBuilder.exe
popd
exit /b 0

:error
echo [FAIL] Build failed. See messages above.
popd
exit /b 1




